# Example env file for using remote model APIs (no local pull)

# Remote Ollama server (replace REMOTE_HOST)
LLM_API_MODE=ollama
LLM_API_URL=http://REMOTE_HOST:11434
LLM_MODEL_NAME=llama3.1:8b
LLM_USE_LOCAL=false

# OR - Hosted Hugging Face Inference (example)
# LLM_API_MODE=hf
# LLM_API_URL=https://api-inference.huggingface.co/models/<owner>/<model>
# LLM_API_TOKEN=hf_xxx
# LLM_MODEL_NAME=<owner>/<model>
# LLM_USE_LOCAL=false

# OR - webui (text-generation-webui) remote instance
# LLM_API_MODE=webui
# LLM_API_URL=http://REMOTE_WEBUI_HOST:8000
# LLM_MODEL_NAME="<model-name-if-needed>"
# LLM_USE_LOCAL=false
