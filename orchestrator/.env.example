# Example environment variables for orchestrator
# Use local rule-based analyzer (no external LLM, free)
LLM_USE_LOCAL=true

# By default the server returns a fast deterministic analysis and runs LLM
# enrichment asynchronously. Set the following to force blocking behavior:
# LLM_BLOCKING=true  # (default: false) — /run will wait for LLM to finish (slower)
# Tune LLM network timeout (ms): LLM_TIMEOUT_MS=5000 (default 5000)

# Or point to a local text-generation-webui instance (free local models)
# Start text-generation-webui on your machine and set:
# LLM_API_URL=http://localhost:7860
# LLM_API_MODE=webui
# LLM_MODEL_NAME=<model_name_installed_in_webui>

# Or point to a local Ollama server (free local models you install with Ollama)
# Install Ollama (https://ollama.ai) and run the daemon. Default port is 11434.
# Then set:
# LLM_API_URL=http://localhost:11434
# LLM_API_MODE=ollama
# LLM_MODEL_NAME=<model-name-on-ollama>

# Or point to remote LLM (requires token/credits)
# LLM_API_URL=https://router.huggingface.co/v1
# LLM_API_TOKEN=hf_xxx
# LLM_MODEL_NAME=moonshotai/Kimi-K2-Instruct-0905
